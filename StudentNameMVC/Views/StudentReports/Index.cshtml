@model AIVES.BLL.Models.ExamReporting.StudentReportDto
@{
    ViewData["Title"] = "Báo cáo Kết quả Học tập & Thi Vấn Đáp (Sinh viên)";
    var availableExams = ViewBag.AvailableExams as List<AIVES.BLL.Models.ExamReporting.ExamSettingsSnapshot> ?? new();
    string selectedExamId = ViewBag.SelectedExamId as string ?? "EXAM01";
    string selectedStudentId = ViewBag.SelectedStudentId as string ?? "SV01";

    if (Model != null)
    {
        ViewData["EvaluationMode"] = Model.EvaluationMode;
    }
}

<div class="container-fluid py-4">
    <!-- Header & Switcher Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-primary">
                <i class="bi bi-mortarboard-fill me-2"></i>Báo Cáo Học Tập & Phản Hồi Thi Vấn Đáp AI
            </h2>
            <p class="text-muted mb-0">Hệ thống khảo thí thông minh AIVES · Xem lại chi tiết Transcript vấn đáp, câu hỏi đào sâu của AI và nhận xét nâng cao năng lực.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <!-- Exam Switcher (Hỗ trợ chuyển đổi nhanh giữa Score Mode & Pass/Fail Mode) -->
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-secondary small"><i class="bi bi-journal-bookmark me-1"></i>Kỳ thi:</span>
                <div class="btn-group shadow-sm" role="group">
                    @foreach (var ex in availableExams)
                    {
                        bool isCurrentExam = ex.ExamId == selectedExamId;
                        string modeLabel = ex.EvaluationMode == AIVES.BLL.Models.ExamReporting.ExamEvaluationMode.PassFail ? "Pass/Fail" : "Điểm";
                        <a asp-action="Index" asp-route-studentId="@selectedStudentId" asp-route-examId="@ex.ExamId"
                           class="btn btn-sm @(isCurrentExam ? "btn-primary fw-bold" : "btn-outline-primary")"
                           title="@ex.ExamTitle">
                            @ex.ExamId <span class="badge @(isCurrentExam ? "bg-white text-primary" : "bg-primary-subtle text-primary") ms-1">@modeLabel</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Student Profile Switcher -->
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-secondary small"><i class="bi bi-person-bounding-box me-1"></i>Hồ sơ SV:</span>
                <div class="btn-group shadow-sm" role="group">
                    <a asp-action="Index" asp-route-studentId="SV01" asp-route-examId="@selectedExamId"
                       class="btn btn-sm @(selectedStudentId == "SV01" ? "btn-primary fw-bold" : "btn-outline-primary")">
                        SV01 (Nguyễn Văn A)
                    </a>
                    <a asp-action="Index" asp-route-studentId="SV02" asp-route-examId="@selectedExamId"
                       class="btn btn-sm @(selectedStudentId == "SV02" ? "btn-primary fw-bold" : "btn-outline-primary")">
                        SV02 (Trần Thị B)
                    </a>
                    <a asp-action="Index" asp-route-studentId="SV03" asp-route-examId="@selectedExamId"
                       class="btn btn-sm @(selectedStudentId == "SV03" ? "btn-primary fw-bold" : "btn-outline-primary")">
                        SV03 (Lê Văn C)
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null)
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-primary text-white h-100">
                    <div class="card-body py-3">
                        <small class="text-white-50 text-uppercase fw-bold">Học viên</small>
                        <h4 class="fw-bold mb-1">@Model.StudentName</h4>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="badge bg-light text-primary">MSSV: @Model.StudentId</span>
                            <span class="badge bg-white text-dark border">
                                @(Model.EvaluationMode == AIVES.BLL.Models.ExamReporting.ExamEvaluationMode.PassFail ? "Chế độ Đạt/K.Đạt" : "Chế độ Điểm số")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-white h-100 border-start border-4 border-info">
                    <div class="card-body py-3">
                        <small class="text-muted text-uppercase fw-bold">Số lượt thi hoàn thành</small>
                        <h3 class="fw-bold text-dark mb-1">
                            @Model.CompletedAttemptsCount / @Model.MaxAllowedAttemptsCount
                        </h3>
                        <small class="text-muted">
                            (Đã chấm: <strong>@Model.GradedAttemptsCount</strong>, Chờ chấm: <strong>@Model.PendingAttemptsCount</strong>)
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-white h-100 border-start border-4 border-success">
                    <div class="card-body py-3">
                        <small class="text-muted text-uppercase fw-bold">Điểm trung bình học tập</small>
                        <h3 class="fw-bold text-success mb-1">
                            @if (Model.EvaluationMode == AIVES.BLL.Models.ExamReporting.ExamEvaluationMode.PassFail)
                            {
                                <span class="fs-5 text-dark fw-bold">Không áp dụng</span>
                            }
                            else
                            {
                                @(Model.AverageScore.HasValue ? Model.AverageScore.Value.ToString("0.00") : "Chưa có")
                            }
                        </h3>
                        <small class="text-muted">
                            @if (Model.EvaluationMode == AIVES.BLL.Models.ExamReporting.ExamEvaluationMode.PassFail)
                            {
                                <span>Chế độ Đạt/Không đạt (DEC-04)</span>
                            }
                            else
                            {
                                <span>Tính từ @Model.GradedAttemptsCount lượt có kết quả đầy đủ</span>
                            }
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-white h-100 border-start border-4" style="border-left-color: #d97706 !important;">
                    <div class="card-body py-3">
                        <small class="text-muted text-uppercase fw-bold">Tỷ lệ đạt chuẩn</small>
                        <h3 class="fw-bold text-amber-contrast mb-1">
                            @(Model.PassRatePercentage.HasValue ? $"{Model.PassRatePercentage.Value:0.#}%" : "Chưa có")
                        </h3>
                        <small class="text-muted">Căn cứ Rubric & Chuẩn đầu ra</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Attempts Details -->
        <h4 class="fw-bold text-dark mb-3">
            <i class="bi bi-journal-check text-primary me-2"></i>Chi Tiết Bài Thi & Nhận Xét Của AI Từng Lượt
        </h4>

        @if (!Model.Attempts.Any())
        {
            <div class="alert alert-info">Chưa có bản ghi lượt thi nào cho sinh viên này trong kỳ thi @Model.ExamTitle.</div>
        }
        else
        {
            <div class="accordion shadow-sm" id="attemptsAccordion">
                @foreach (var attempt in Model.Attempts)
                {
                    bool isExpanded = attempt.AttemptOrdinal == 1;
                    string collapseId = $"collapseAttempt_{attempt.AttemptId}";
                    string headingId = $"headingAttempt_{attempt.AttemptId}";

                    <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-sm">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(isExpanded ? "" : "collapsed") bg-light" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                    aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseId">
                                <div class="d-flex flex-wrap align-items-center justify-content-between w-100 me-3">
                                    <div>
                                        <span class="badge bg-secondary me-2">Lượt thi #@attempt.AttemptOrdinal</span>
                                        <span class="fw-bold text-dark">
                                            @(attempt.CompletedAt.HasValue ? attempt.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa hoàn thành")
                                        </span>
                                    </div>
                                    <div class="mt-2 mt-md-0 d-flex gap-2 align-items-center">
                                        @if (attempt.ExamState == AIVES.BLL.Models.ExamReporting.ExamState.Abandoned)
                                        {
                                            <span class="badge bg-danger">Bỏ dở (DEC-01: Không tính lượt)</span>
                                        }
                                        else if (attempt.GradingState == AIVES.BLL.Models.ExamReporting.GradingState.Pending)
                                        {
                                            <span class="badge badge-amber-contrast"><i class="bi bi-hourglass-split me-1"></i>Đang chờ AI chấm</span>
                                        }
                                        else
                                        {
                                            <span class="badge @(attempt.IsPassed ? "bg-success" : "bg-danger")">
                                                @(attempt.IsPassed ? "ĐẠT CHUẨN" : "CHƯA ĐẠT")
                                            </span>
                                            @if (Model.EvaluationMode == AIVES.BLL.Models.ExamReporting.ExamEvaluationMode.PassFail)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info">
                                                    Pass/Fail Mode
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">
                                                    Điểm: @attempt.TotalEarnedScore / @attempt.TotalMaxScore (@attempt.NormalizedScore.ToString("0.0")/10)
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(isExpanded ? "show" : "")"
                             aria-labelledby="@headingId" data-bs-parent="#attemptsAccordion">
                            <div class="accordion-body p-3 p-md-4 bg-white">
                                @if (attempt.ExamState == AIVES.BLL.Models.ExamReporting.ExamState.Abandoned)
                                {
                                    <div class="alert alert-secondary mb-0">
                                        <i class="bi bi-exclamation-circle me-1"></i> Lượt thi này sinh viên đã hủy hoặc bỏ dở giữa chừng. Theo quy định DEC-01, lượt thi này không được tính vào số lượt hoàn thành và không có điểm.
                                    </div>
                                }
                                else if (!attempt.QuestionResults.Any())
                                {
                                    <div class="alert alert-light">Không có câu hỏi nào trong lượt thi này.</div>
                                }
                                else
                                {
                                    <!-- Render chi tiết câu hỏi theo 5 khối tuần tự qua Shared Partial Component -->
                                    <div class="vstack gap-4">
                                        @foreach (var q in attempt.QuestionResults)
                                        {
                                            <partial name="_QuestionDetailCardPartial" model="q" view-data="ViewData" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
