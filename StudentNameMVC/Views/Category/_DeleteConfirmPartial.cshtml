@model StudentNameMVC.ViewModels.CategoryDeleteViewModel

@{
ViewData["Title"] = "Tạo danh mục mới";
}

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content shadow border-0">
			<form id="deleteCategoryForm" asp-controller="CategoryArticle" asp-action="Delete" asp-route-id="@Model.CategoryId" method="post">
				@Html.AntiForgeryToken()
				<div class="modal-header bg-danger text-white">
					<h5 class="modal-title" id="deleteModalLabel">
						<i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa danh mục
					</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body p-4 text-center">
					<div class="mb-3 text-danger">
						<i class="bi bi-trash3" style="font-size: 3rem;"></i>
					</div>
					<p class="fs-5 mb-2">Bạn có chắc chắn muốn xóa danh mục này không?</p>
					<div class="alert alert-light border fw-bold text-dark text-break">
						"@Model.CategoryName"
					</div>
				</div>
				<div class="modal-footer bg-light justify-content-center">
					<button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
						<i class="bi bi-x-circle me-1"></i> Hủy bỏ
					</button>
					<button type="submit" class="btn btn-danger px-4" id="btnConfirmDelete">
						<i class="bi bi-trash me-1"></i> Xác nhận xóa
					</button>
				</div>
			</form>
		</div>
	</div>
</div>