@model StudentNameMVC.ViewModels.CategoryFormViewModel

@{
ViewData["Title"] = "Tạo danh mục mới";
}

<div class="modal fade" id="newsModal" tabindex="-1" aria-labelledby="newsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form id="editNewsForm" asp-controller="Category" asp-action="Edit" asp-route-id="@Model.CategoryId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CategoryId" />

				<div class="modal-header bg-primary text-white">
					<h5 class="modal-title" id="categoryModalLabel">
						<i class="bi bi-plus-circle me-2"></i> Tạo danh mục mới
					</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body p-4">
					<div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 mb-3" role="alert"></div>

					<div class="mb-3">
						<label asp-for="CategoryName" class="form-label fw-bold"></label>
						<span class="text-danger">*</span>
						<input asp-for="CategoryName" class="form-control" placeholder="Nhập tên danh mục mới..." maxlength="200" required="" />
						<span asp-validation-for="CategoryName" class="text-danger small"></span>
					</div>

					<div class="mb-3">
						<label asp-for="CategoryDescription" class="form-label fw-bold"></label>
						<span class="text-danger">*</span>
						<textarea asp-for="CategoryDescription" class="form-control" rows="6" maxlength="500" placeholder="Nhập tiêu đề tin tức (tối đa 500 ký tự)..." required=""></textarea>
						<span asp-validation-for="CategoryDescription" class="text-danger small"></span>
					</div>
				</div>
				<div class="modal-footer bg-light">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						<i class="bi bi-x-circle me-1"></i> Hủy bỏ
					</button>
					<button type="submit" class="btn btn-warning fw-bold" id="btnSubmitNews">
						<i class="bi bi-save me-1"></i> Cập nhật thay đổi
					</button>
				</div>
            </form>
        </div>
    </div>
</div>