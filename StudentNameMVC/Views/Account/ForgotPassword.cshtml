@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="auth-shell"><section class="auth-panel">
    <h1 class="h3">Quên mật khẩu</h1>
    @if (Model.Submitted)
    {
        <p role="status">Nếu email thuộc tài khoản đang hoạt động, bạn sẽ nhận được liên kết khôi phục mật khẩu.</p>
    }
    else
    {
        <form asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Gửi liên kết khôi phục</button>
        </form>
    }
    <a asp-action="Login" class="d-block mt-3">Về trang đăng nhập</a>
</section></div>
