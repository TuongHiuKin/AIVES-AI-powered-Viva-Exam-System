@model StudentNameMVC.ViewModels.AccountIndexViewModel
@{
    ViewData["Title"] = "Quản lý Tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Quản lý Tài khoản
        </h2>
        <p class="text-muted small mb-0">Quản trị danh sách tài khoản Staff và Lecturer trong hệ thống</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="bi bi-person-plus-fill me-1"></i> Thêm tài khoản mới
        </button>
    </div>
</div>

<!-- Thống kê tổng quan -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-primary border-4">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng tài khoản</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalAccounts</h3>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-success border-4">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Sinh viên</span>
                    <h3 class="fw-bold mb-0 text-success">@Model.TotalStudents</h3>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-info border-4">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Giảng viên (Lecturer)</span>
                    <h3 class="fw-bold mb-0 text-info">@Model.TotalLecturer</h3>
                </div>
                <div class="bg-info-subtle text-info p-3 rounded-circle">
                    <i class="bi bi-mortarboard fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm & vai trò -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form asp-controller="Account" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-7">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0 ps-0"
                           placeholder="Tìm kiếm tài khoản theo Họ tên hoặc Địa chỉ Email..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="roleFilter" class="form-select">
                    <option value="" selected="@(Model.RoleFilter == null)">-- Tất cả vai trò --</option>
                    <option value="1" selected="@(Model.RoleFilter == 1)">Sinh viên</option>
                    <option value="2" selected="@(Model.RoleFilter == 2)">Giảng viên</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-funnel me-1"></i> Tìm kiếm
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.RoleFilter.HasValue)
                {
                    <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách tài khoản -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 70px;">ID</th>
                        <th style="width: 130px;">MSSV</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th style="width: 140px;">Lớp</th>
                        <th class="text-center" style="width: 130px;">Vai trò</th>
                        <th class="text-center" style="width: 120px;">Trạng thái</th>
                        <th class="text-center pe-4" style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Accounts != null && Model.Accounts.Any())
                    {
                        @foreach (var account in Model.Accounts)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-muted">#@account.AccountId</td>
                                <td>
                                    @if (account.AccountRole == 2)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(account.StudentCode))
                                    {
                                        <span class="fw-semibold text-dark">@account.StudentCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Chưa cập nhật</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@account.AccountName</div>
                                </td>
                                <td>
                                    <span class="text-dark">@account.AccountEmail</span>
                                </td>
                                <td>
                                    @if (account.AccountRole == 2)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(account.ClassName))
                                    {
                                        <span class="badge bg-light text-dark border">@account.ClassName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Chưa cập nhật</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (account.AccountRole == 1)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                            <i class="bi bi-person-badge me-1"></i> Sinh viên
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-1">
                                            <i class="bi bi-mortarboard me-1"></i> Giảng viên
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (account.IsDeleted)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                            <i class="bi bi-lock-fill me-1"></i> Đã khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">
                                            <i class="bi bi-check-circle me-1"></i> Hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-warning" title="Chỉnh sửa tài khoản"
                                                onclick="openEditModal(@account.AccountId)">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </button>
                                        @if (!account.IsDeleted)
                                        {
                                            <button type="button" class="btn btn-outline-danger" title="Khóa / Xóa mềm"
                                                    onclick="openDeleteModal(@account.AccountId)">
                                                <i class="bi bi-lock me-1"></i> Khóa
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-dark" title="Xóa vĩnh viễn"
                                                onclick="openHardDeleteModal(@account.AccountId)">
                                            <i class="bi bi-trash3 me-1"></i> Xóa cứng
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2"></i>
                                <p class="mb-1">Không tìm thấy tài khoản nào phù hợp.</p>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="openCreateModal()">
                                    <i class="bi bi-person-plus-fill me-1"></i> Thêm tài khoản đầu tiên
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Dọn dẹp modal cũ và backdrop trước khi mở modal mới hoặc re-render (tránh kẹt backdrop)
        function cleanupExistingModal() {
            $('.modal').each(function () {
                const instance = bootstrap.Modal.getInstance(this);
                if (instance) {
                    try {
                        instance.hide();
                        instance.dispose();
                    } catch (e) {
                        // Bỏ qua lỗi dispose nếu modal đang trong trạng thái chuyển tiếp
                    }
                }
            });
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css({
                'overflow': '',
                'padding-right': ''
            });
        }

        // Tự động dọn dẹp backdrop khi bất kỳ modal nào đóng lại
        $(document).on('hidden.bs.modal', '.modal', function () {
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css({
                'overflow': '',
                'padding-right': ''
            });
        });

        // Mở Modal Tạo mới tài khoản (ACC-03)
        function openCreateModal() {
            cleanupExistingModal();
            $.get('@Url.Action("CreateModal", "Account")', function (data) {
                $('#modalContainer').html(data);
                const modalEl = document.getElementById('accountModal');
                const modal = new bootstrap.Modal(modalEl);
                bindAjaxForm('#createAccountForm', modal);
                modal.show();
            }).fail(function () {
                alert('Không thể tải biểu mẫu tạo tài khoản.');
            });
        }

        // Mở Modal Chỉnh sửa tài khoản (ACC-04)
        function openEditModal(id) {
            cleanupExistingModal();
            $.get('@Url.Action("EditModal", "Account")', { id: id }, function (data) {
                $('#modalContainer').html(data);
                const modalEl = document.getElementById('accountModal');
                const modal = new bootstrap.Modal(modalEl);
                bindAjaxForm('#editAccountForm', modal);
                modal.show();
            }).fail(function () {
                alert('Không thể tải thông tin tài khoản để chỉnh sửa.');
            });
        }

        // Mở Modal Xác nhận xóa mềm (ACC-05)
        function openDeleteModal(id) {
            cleanupExistingModal();
            $.get('@Url.Action("DeleteModal", "Account")', { id: id }, function (data) {
                $('#modalContainer').html(data);
                const modalEl = document.getElementById('deleteAccountModal');
                const modal = new bootstrap.Modal(modalEl);
                bindAjaxDeleteForm('#deleteAccountForm', modal);
                modal.show();
            }).fail(function () {
                alert('Không thể tải thông tin xác nhận xóa.');
            });
        }

        // Mở Modal Xác nhận xóa vĩnh viễn (ACC-05)
        function openHardDeleteModal(id) {
            cleanupExistingModal();
            $.get('@Url.Action("HardDeleteModal", "Account")', { id: id }, function (data) {
                $('#modalContainer').html(data);
                const modalEl = document.getElementById('hardDeleteAccountModal');
                const modal = new bootstrap.Modal(modalEl);
                bindAjaxDeleteForm('#hardDeleteAccountForm', modal);
                modal.show();
            }).fail(function () {
                alert('Không thể tải thông tin xác nhận xóa vĩnh viễn.');
            });
        }

        // Xử lý submit AJAX cho Form Create / Edit
        function bindAjaxForm(formSelector, modalInstance) {
            $(formSelector).off('submit').on('submit', function (e) {
                e.preventDefault();
                const form = $(this);
                const submitBtn = form.find('#btnSubmitAccount');
                submitBtn.prop('disabled', true).prepend('<span class="spinner-border spinner-border-sm me-1" role="status"></span>');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function (res) {
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                        cleanupExistingModal();
                        window.location.reload();
                    },
                    error: function (xhr) {
                        submitBtn.prop('disabled', false).find('.spinner-border').remove();
                        if (xhr.status === 400) {
                            // Dọn dẹp modal cũ và backdrop trước khi render lại form chứa validation errors
                            cleanupExistingModal();
                            $('#modalContainer').html(xhr.responseText);
                            const modalEl = document.getElementById('accountModal');
                            if (modalEl) {
                                const updatedModal = new bootstrap.Modal(modalEl);
                                bindAjaxForm(formSelector, updatedModal);
                                updatedModal.show();
                            }
                        } else {
                            alert('Đã xảy ra lỗi khi lưu thông tin tài khoản.');
                        }
                    }
                });
            });
        }

        // Xử lý submit AJAX cho Form Delete / HardDelete
        function bindAjaxDeleteForm(formSelector, modalInstance) {
            $(formSelector).off('submit').on('submit', function (e) {
                e.preventDefault();
                const form = $(this);
                const deleteBtn = form.find('button[type="submit"]');
                deleteBtn.prop('disabled', true).prepend('<span class="spinner-border spinner-border-sm me-1" role="status"></span>');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function () {
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                        cleanupExistingModal();
                        window.location.reload();
                    },
                    error: function (xhr) {
                        deleteBtn.prop('disabled', false).find('.spinner-border').remove();
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            alert(xhr.responseJSON.message);
                        } else {
                            alert('Đã xảy ra lỗi trong quá trình thực hiện xóa.');
                        }
                    }
                });
            });
        }
    </script>
}
