@model ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<div class="auth-shell"><section class="auth-panel">
    <h1 class="h3">Đặt lại mật khẩu</h1>
    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Đặt lại mật khẩu</button>
    </form>
    <a asp-action="ForgotPassword" class="d-block mt-3">Yêu cầu liên kết mới</a>
</section></div>
