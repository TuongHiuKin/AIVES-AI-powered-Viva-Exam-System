@model AIVES.BLL.Models.ExamReporting.QuestionResultDto
@{
    // Xác định chế độ đánh giá (ưu tiên ViewData nếu caller truyền vào, ngược lại lấy từ Model)
    var evalMode = ViewData["EvaluationMode"] as AIVES.BLL.Models.ExamReporting.ExamEvaluationMode? 
                   ?? Model.EvaluationMode;
    bool isPassFailMode = evalMode == AIVES.BLL.Models.ExamReporting.ExamEvaluationMode.PassFail;
}

<div class="aives-q-card shadow-sm">
    <!-- KHỐI 1: (1) Nội dung Câu hỏi chính (kèm Bloom level, mã câu hỏi) -->
    <!-- Lưu ý: Huy hiệu điểm số và trạng thái KHÔNG đứng trước câu hỏi để tránh làm phân tâm người đọc -->
    <div class="aives-q-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary px-2.5 py-1.5 fs-6">
                <i class="bi bi-question-circle-fill me-1"></i> Câu @Model.QuestionId
            </span>
            <span class="badge bg-info-subtle text-info-emphasis border border-info px-2.5 py-1.5">
                <i class="bi bi-diagram-3-fill me-1"></i>Thang Bloom: @Model.CognitiveLevel
            </span>
        </div>
        <div class="text-secondary small fw-semibold">
            <i class="bi bi-mortarboard me-1"></i>(Khối 1: Nội dung Câu hỏi chính)
        </div>
    </div>

    <div class="p-3 p-md-4">
        <!-- Nội dung câu hỏi chính -->
        <div class="aives-q-title-box mb-4">
            <h5 class="fw-bold text-dark mb-0 lh-base">
                @Model.QuestionTitle
            </h5>
        </div>

        <!-- KHỐI 2: (2) Câu trả lời của thí sinh (kèm transcript đối thoại đào sâu của AI - Adaptive Follow-up) -->
        <div class="mb-4">
            <div class="aives-block-heading">
                <span class="aives-block-badge-num">2</span>
                <span>Câu trả lời của thí sinh & Transcript đào sâu của AI (Adaptive Follow-up)</span>
            </div>

            <div class="aives-transcript-flow">
                <div class="fw-bold text-secondary small mb-2 text-uppercase d-flex align-items-center">
                    <i class="bi bi-mic-fill text-danger me-1.5"></i> Nhật Ký Vấn Đáp Giọng Nói (Speech-to-Text Transcript):
                </div>

                <!-- 2.1 Thí sinh trả lời ban đầu -->
                <div class="aives-answer-box mb-3">
                    <div class="small fw-bold text-primary mb-1">
                        <i class="bi bi-person-fill me-1"></i> Thí sinh trả lời ban đầu:
                    </div>
                    <p class="mb-0 text-dark fst-italic lh-base" style="font-size: 0.95rem;">
                        @(string.IsNullOrWhiteSpace(Model.StudentInitialAnswerTranscript) 
                            ? "Chưa có bản ghi âm câu trả lời ban đầu." 
                            : $"\"{Model.StudentInitialAnswerTranscript}\"")
                    </p>
                </div>

                <!-- 2.2 AI Giám khảo hỏi xoáy / làm rõ (Adaptive Follow-up) -->
                @if (!string.IsNullOrWhiteSpace(Model.AiFollowUpQuestion))
                {
                    <div class="aives-followup-box mb-3">
                        <div class="aives-followup-title mb-1">
                            <i class="bi bi-robot me-1.5"></i> <strong>AI Giám Khảo Hỏi Xoáy / Làm Rõ (Adaptive Follow-up):</strong>
                        </div>
                        <p class="mb-0 aives-followup-text">
                            @Model.AiFollowUpQuestion
                        </p>
                    </div>

                    <!-- 2.3 Thí sinh phản hồi câu hỏi đào sâu -->
                    <div class="aives-followup-answer-box">
                        <div class="small fw-bold text-success mb-1">
                            <i class="bi bi-person-check-fill me-1"></i> Thí sinh phản hồi câu hỏi đào sâu:
                        </div>
                        <p class="mb-0 text-dark fst-italic lh-base" style="font-size: 0.95rem;">
                            @(string.IsNullOrWhiteSpace(Model.StudentFollowUpAnswerTranscript) 
                                ? "Chưa có bản ghi câu trả lời bổ sung." 
                                : $"\"{Model.StudentFollowUpAnswerTranscript}\"")
                        </p>
                    </div>
                }
            </div>
        </div>

        <!-- KHỐI 3: (3) Ghi chú / Nhận xét của Giảng viên -->
        <div class="mb-4">
            <div class="aives-block-heading">
                <span class="aives-block-badge-num">3</span>
                <span>Ghi chú / Nhận xét của Giảng viên (Human-in-the-loop)</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.TeacherNotes))
            {
                <div class="aives-teacher-notes-box">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-person-workspace fs-5 text-primary flex-shrink-0 mt-0.5"></i>
                        <div>
                            <strong class="d-block mb-1 text-primary">Nhận xét từ Giảng viên phụ trách:</strong>
                            <p class="mb-0 text-dark fw-medium fs-6 lh-base">@Model.TeacherNotes</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="aives-teacher-notes-empty">
                    <i class="bi bi-info-circle me-1.5"></i>
                    <em>Chưa có ghi chú bổ sung từ giảng viên cho câu hỏi này.</em>
                </div>
            }
        </div>

        <!-- KHỐI 4: (4) Đánh giá chi tiết của AI (Điểm mạnh, Điểm cần cải thiện, Điểm AI đề xuất, Điểm GV chốt) -->
        <div class="mb-4">
            <div class="aives-block-heading">
                <span class="aives-block-badge-num">4</span>
                <span>Đánh giá chi tiết của AI & Kết quả</span>
            </div>

            <!-- Thanh Huy hiệu (Badges) Điểm số & Trạng thái được đặt ở ĐÂY theo đúng checklist -->
            <div class="aives-badges-bar mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (Model.GradingState == AIVES.BLL.Models.ExamReporting.GradingState.Pending)
                    {
                        <span class="badge badge-amber-contrast px-3 py-2 fs-6">
                            <i class="bi bi-hourglass-split me-1"></i>Đang chờ AI chấm điểm
                        </span>
                    }
                    else
                    {
                        @if (Model.IsPassed)
                        {
                            <span class="badge bg-success px-3 py-2 fs-6 fw-bold">
                                <i class="bi bi-check-circle-fill me-1"></i> ĐẠT CHUẨN
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger px-3 py-2 fs-6 fw-bold">
                                <i class="bi bi-x-circle-fill me-1"></i> CHƯA ĐẠT
                            </span>
                        }

                        @if (isPassFailMode)
                        {
                            <span class="badge bg-info-subtle text-info-emphasis border border-info px-2.5 py-2">
                                <i class="bi bi-shield-check me-1"></i>Chế độ Đạt / Không đạt (Pass/Fail Mode)
                            </span>
                        }
                    }
                </div>

                @if (!isPassFailMode && Model.GradingState != AIVES.BLL.Models.ExamReporting.GradingState.Pending)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary px-2.5 py-2" title="Điểm do AI đề xuất">
                            <i class="bi bi-robot me-1 text-primary"></i>AI đề xuất: <strong>@Model.AiSuggestedScore / @Model.MaxScore</strong>
                        </span>
                        <span class="badge bg-success-subtle text-success-emphasis border border-success px-2.5 py-2" title="Điểm do Giảng viên chốt cuối cùng (Human-in-the-loop)">
                            <i class="bi bi-person-check-fill me-1 text-success"></i>GV chốt: <strong>@Model.TeacherFinalScore / @Model.MaxScore</strong>
                        </span>
                        <span class="badge bg-primary px-3 py-2 fs-6 fw-bold" title="Điểm chính thức đạt được">
                            <i class="bi bi-award-fill me-1"></i>Điểm: @Model.EarnedScore / @Model.MaxScore
                        </span>
                    </div>
                }
            </div>

            <!-- Nhận xét chi tiết của AI -->
            @if (!string.IsNullOrWhiteSpace(Model.AiFeedback))
            {
                <div class="aives-ai-feedback-box mb-3">
                    <div class="fw-bold text-dark mb-1">
                        <i class="bi bi-chat-square-dots-fill text-primary me-1.5"></i> Nhận xét phân tích của AI:
                    </div>
                    <p class="mb-0 text-dark">@Model.AiFeedback</p>
                </div>
            }

            <!-- Điểm mạnh & Điểm cần cải thiện -->
            <div class="row g-3">
                @if (!string.IsNullOrWhiteSpace(Model.Strengths))
                {
                    <div class="@(string.IsNullOrWhiteSpace(Model.Weaknesses) ? "col-12" : "col-md-6")">
                        <div class="aives-strength-box">
                            <div class="fw-bold mb-1" style="color: #15803d;">
                                <i class="bi bi-hand-thumbs-up-fill me-1.5"></i> Điểm mạnh đạt được:
                            </div>
                            <div class="lh-base" style="font-size: 0.92rem;">@Model.Strengths</div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Weaknesses))
                {
                    <div class="@(string.IsNullOrWhiteSpace(Model.Strengths) ? "col-12" : "col-md-6")">
                        <div class="aives-weakness-box">
                            <div class="fw-bold mb-1" style="color: #be123c;">
                                <i class="bi bi-exclamation-triangle-fill me-1.5"></i> Điểm cần cải thiện & Ý còn thiếu:
                            </div>
                            <div class="lh-base" style="font-size: 0.92rem;">@Model.Weaknesses</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- KHỐI 5: (5) Tiêu chí Rubric chi tiết (Điểm tối đa, Ngưỡng đạt chuẩn) -->
        <div>
            <div class="aives-block-heading">
                <span class="aives-block-badge-num">5</span>
                <span>Tiêu chí Rubric chi tiết & Chuẩn đầu ra</span>
            </div>

            <div class="aives-rubric-box">
                <!-- Thông tin cấu hình chuẩn -->
                <div class="d-flex flex-wrap align-items-center gap-3 mb-2 pb-2 border-bottom">
                    @if (isPassFailMode)
                    {
                        <div>
                            <span class="text-secondary small fw-semibold">Hình thức đánh giá:</span>
                            <span class="badge bg-light text-dark border ms-1">Đạt / Không đạt (Pass/Fail)</span>
                        </div>
                        <div>
                            <span class="text-secondary small fw-semibold">Quy tắc chuẩn:</span>
                            <span class="badge bg-light text-dark border ms-1">Tỷ lệ đạt tối thiểu & Tiêu chí bắt buộc (DEC-04)</span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <span class="text-secondary small fw-semibold">Điểm tối đa câu:</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1 fw-bold">@Model.MaxScore điểm</span>
                        </div>
                        <div>
                            <span class="text-secondary small fw-semibold">Ngưỡng đạt theo Rubric:</span>
                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle ms-1">Cấu hình bởi Giảng viên (DEC-03)</span>
                        </div>
                    }
                </div>

                <!-- Kết quả từng tiêu chí nếu có -->
                @if (Model.CriteriaOutcomes != null && Model.CriteriaOutcomes.Any())
                {
                    <div class="mb-2">
                        <span class="text-secondary small fw-semibold d-block mb-1">Kết quả kiểm tra tiêu chí:</span>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var criterion in Model.CriteriaOutcomes)
                            {
                                <span class="badge @(criterion.Value ? "bg-success-subtle text-success-emphasis border border-success" : "bg-danger-subtle text-danger-emphasis border border-danger") py-1.5 px-2">
                                    <i class="bi @(criterion.Value ? "bi-check2" : "bi-x") me-1"></i>
                                    @criterion.Key: <strong>@(criterion.Value ? "ĐẠT" : "CHƯA ĐẠT")</strong>
                                </span>
                            }
                        </div>
                    </div>
                }

                <!-- Mô tả tiêu chí Rubric chi tiết -->
                <div>
                    <span class="text-secondary small fw-semibold d-block mb-1">
                        <i class="bi bi-card-checklist me-1 text-primary"></i> Mô tả chi tiết tiêu chí Rubric:
                    </span>
                    <p class="mb-0 text-dark fw-medium lh-base">
                        @(string.IsNullOrWhiteSpace(Model.RubricCriteria) ? "Chưa có mô tả rubric cụ thể." : Model.RubricCriteria)
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
