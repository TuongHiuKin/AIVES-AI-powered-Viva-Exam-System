@model AIVES.BLL.Models.ExamReporting.ClassStatisticsDto
@{
    ViewData["Title"] = "Thống kê Lớp Thi Vấn Đáp (Giảng viên)";
    var availableExams = ViewBag.AvailableExams as List<AIVES.BLL.Models.ExamReporting.ExamSettingsSnapshot> ?? new();
    var availableClasses = ViewBag.AvailableClasses as List<string> ?? new();
    string selectedTeacherId = ViewBag.SelectedTeacherId as string ?? "GV01";
    string selectedClassId = ViewBag.SelectedClassId as string ?? "SE1701";
    string selectedExamId = ViewBag.SelectedExamId as string ?? "EXAM01";
    int? selectedAttemptOrdinal = ViewBag.SelectedAttemptOrdinal as int?;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1 text-primary">
                <i class="bi bi-bar-chart-steps me-2"></i>Thống Kê Năng Lực Học Tập Toàn Lớp
            </h2>
            <p class="text-muted mb-0">Hệ thống khảo thí thông minh AIVES · Phân tích câu hỏi khó nhất, tỷ lệ đạt chuẩn và phân bố điểm số sinh viên.</p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
            <!-- Export Grade Sheet Button (Nhóm 6) -->
            <a asp-action="ExportGradeSheet" 
               asp-route-teacherId="@selectedTeacherId" 
               asp-route-classId="@selectedClassId" 
               asp-route-examId="@selectedExamId" 
               class="btn btn-success fw-semibold shadow-sm">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Bảng Điểm (Excel / CSV)
            </a>
            <span class="badge bg-secondary p-2"><i class="bi bi-person-workspace me-1"></i>GV: @selectedTeacherId</span>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <input type="hidden" name="teacherId" value="@selectedTeacherId" />

                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Lớp học phần:</label>
                    <select name="classId" class="form-select form-select-sm">
                        @foreach (var cls in availableClasses)
                        {
                            <option value="@cls" selected="@(cls == selectedClassId)">@cls</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-muted">Kỳ thi vấn đáp:</label>
                    <select name="examId" class="form-select form-select-sm">
                        @foreach (var ex in availableExams)
                        {
                            <option value="@ex.ExamId" selected="@(ex.ExamId == selectedExamId)">@ex.ExamTitle</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Phạm vi lượt thi (DEC-07, DEC-08):</label>
                    <select name="attemptOrdinal" class="form-select form-select-sm">
                        <option value="1" selected="@(selectedAttemptOrdinal == 1)">Lượt thi số 1 (Mặc định)</option>
                        <option value="2" selected="@(selectedAttemptOrdinal == 2)">Lượt thi số 2</option>
                        <option value="" selected="@(!selectedAttemptOrdinal.HasValue)">Gộp tất cả các lượt</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null)
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-white border-start border-4 border-primary h-100">
                    <div class="card-body py-3">
                        <small class="text-muted text-uppercase fw-bold">Tổng số sinh viên</small>
                        <h2 class="fw-bold text-dark mb-0">@Model.TotalStudentsCount</h2>
                        <small class="text-muted">Đã tham gia thi trong lớp @Model.ClassId</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-white border-start border-4 border-success h-100">
                    <div class="card-body py-3">
                        <small class="text-muted text-uppercase fw-bold">Điểm trung bình lớp</small>
                        <h2 class="fw-bold text-success mb-0">@Model.AverageClassScore.ToString("0.00") / 10</h2>
                        <small class="text-muted">Tính trên điểm trung bình của từng sinh viên</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-white border-start border-4 border-danger h-100">
                    <div class="card-body py-3">
                        <small class="text-muted text-uppercase fw-bold">Câu hỏi khó nhất (DEC-09)</small>
                        <h3 class="fw-bold text-danger mb-0">
                            @if (Model.HardestQuestions.Any())
                            {
                                @string.Join(", ", Model.HardestQuestions.Select(q => q.QuestionId))
                            }
                            else
                            {
                                <span>Chưa xác định</span>
                            }
                        </h3>
                        <small class="text-muted">
                            @(Model.HardestQuestions.Any() ? $"Tỷ lệ không đạt: {Model.HardestQuestions.First().FailRate}%" : "Chưa đủ dữ liệu")
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-white border-start border-4 border-info h-100">
                    <div class="card-body py-3">
                        <small class="text-muted text-uppercase fw-bold">Phạm vi thống kê</small>
                        <h4 class="fw-bold text-info mb-0">@Model.DataScopeLabel</h4>
                        <small class="text-muted">@Model.ExamTitle</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hardest Question Alert Callout (DEC-09) -->
        @if (Model.HardestQuestions.Any())
        {
            <div class="alert alert-danger shadow-sm border-danger border-2 mb-4" role="alert">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-exclamation-octagon-fill fs-4 me-2"></i>
                    <h5 class="alert-heading fw-bold mb-0">Phân tích Câu hỏi Khó nhất (Tỷ lệ không đạt cao nhất):</h5>
                </div>
                <p class="mb-2">
                    Hệ thống xác định có <strong>@Model.HardestQuestions.Count câu hỏi</strong> có tỷ lệ sinh viên trả lời không đạt cao nhất là 
                    <strong class="text-danger">@Model.HardestQuestions.First().FailRate%</strong> (đồng hạng theo DEC-09):
                </p>
                <ul class="mb-0">
                    @foreach (var hq in Model.HardestQuestions)
                    {
                        <li>
                            <strong>[@hq.QuestionId - Thang Bloom: @hq.CognitiveLevel]</strong> @hq.QuestionTitle 
                            — <em>Số lượt không đạt: @hq.FailedCount / @hq.TotalAssessed (Tỷ lệ đạt: @hq.PassRate%)</em>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- Charts & Analytics Section -->
        <div class="row g-4 mb-4">
            <!-- Score Distribution Histogram (DEC-06) -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-bar-chart-fill text-primary me-2"></i>Biểu Đồ Phân Bố Điểm (DEC-06)
                        </h5>
                        <small class="text-muted">Trục X: Điểm trung bình bài thi của SV · Trục Y: Số lượng sinh viên đạt mức điểm đó</small>
                    </div>
                    <div class="card-body">
                        <canvas id="scoreDistributionChart" height="230"></canvas>
                    </div>
                </div>
            </div>

            <!-- Best Answered Questions Ranking Card -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-trophy-fill text-warning me-2"></i>Xếp Hạng Câu Trả Lời Tốt (DEC-09)
                        </h5>
                        <small class="text-muted">Xếp theo thứ tự tỷ lệ đạt giảm dần (ngưỡng đạt cấu hình bởi GV)</small>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Hạng</th>
                                        <th>Mã câu</th>
                                        <th>Cấp độ Bloom</th>
                                        <th>Tỷ lệ đạt</th>
                                        <th>Đạt / Đã chấm</th>
                                        <th>Đánh giá</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var q in Model.QuestionStats)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-bold">#@q.Rank</td>
                                            <td class="fw-semibold text-primary">@q.QuestionId</td>
                                            <td><span class="badge bg-light text-dark border">@q.CognitiveLevel</span></td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 8px;">
                                                        <div class="progress-bar @(q.PassRate >= 60 ? "bg-success" : "bg-warning")" 
                                                             role="progressbar" style="width: @q.PassRate%"></div>
                                                    </div>
                                                    <span class="fw-bold small">@q.PassRate%</span>
                                                </div>
                                            </td>
                                            <td>@q.PassedCount / @q.TotalAssessed</td>
                                            <td>
                                                @if (q.IsHardest)
                                                {
                                                    <span class="badge bg-danger">Khó nhất</span>
                                                }
                                                else if (q.PassRate >= 60)
                                                {
                                                    <span class="badge bg-success">Tốt</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Trung bình</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grade Sheet Table Preview for Class (Nhóm 6) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-file-earmark-spreadsheet-fill text-success me-2"></i>Bảng Điểm Tổng Hợp Lớp Học Phần (@Model.ClassId)
                    </h5>
                    <small class="text-muted">Danh sách điểm thi vấn đáp chuẩn bị xuất báo cáo học vụ</small>
                </div>
                <a asp-action="ExportGradeSheet" 
                   asp-route-teacherId="@selectedTeacherId" 
                   asp-route-classId="@selectedClassId" 
                   asp-route-examId="@selectedExamId" 
                   class="btn btn-sm btn-outline-success fw-semibold">
                    <i class="bi bi-download me-1"></i> Tải file .CSV Excel
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">STT</th>
                                <th>Mã SV</th>
                                <th>Họ và tên</th>
                                <th>Lớp</th>
                                <th>Lượt thi 1</th>
                                <th>Lượt thi 2</th>
                                <th>Điểm TB (Thang 10)</th>
                                <th>Kết quả</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int stt = 1; }
                            @foreach (var row in Model.GradeExportRows)
                            {
                                <tr>
                                    <td class="ps-3">@(stt++)</td>
                                    <td class="fw-bold text-primary">@row.StudentId</td>
                                    <td class="fw-semibold">@row.StudentName</td>
                                    <td>@row.ClassId</td>
                                    <td><span class="badge bg-light text-dark border">@row.Attempt1Score</span></td>
                                    <td><span class="badge bg-light text-dark border">@row.Attempt2Score</span></td>
                                    <td><span class="fw-bold text-success fs-6">@row.AverageScore</span></td>
                                    <td>
                                        <span class="badge @(row.ResultStatus == "ĐẠT" ? "bg-success" : "bg-danger")">
                                            @row.ResultStatus
                                        </span>
                                    </td>
                                    <td class="text-muted small">@row.Note</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Full Question Statistics Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-table text-secondary me-2"></i>Chi Tiết Thống Kê Từng Câu Hỏi Trong Ngân Hàng
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã</th>
                                <th style="width: 40%;">Nội dung câu hỏi</th>
                                <th>Cấp độ nhận thức</th>
                                <th>Tổng đánh giá</th>
                                <th>Đạt</th>
                                <th>Không đạt</th>
                                <th>Tỷ lệ đạt</th>
                                <th>Tỷ lệ không đạt</th>
                                <th>Đánh giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model.QuestionStats)
                            {
                                <tr class="@(q.IsHardest ? "table-danger" : "")">
                                    <td class="ps-3 fw-bold">@q.QuestionId</td>
                                    <td>@q.QuestionTitle</td>
                                    <td><span class="badge bg-info text-dark">@q.CognitiveLevel</span></td>
                                    <td><span class="badge bg-light text-dark border">@q.TotalAssessed</span></td>
                                    <td class="text-success fw-bold">@q.PassedCount</td>
                                    <td class="text-danger fw-bold">@q.FailedCount</td>
                                    <td><span class="badge bg-success">@q.PassRate%</span></td>
                                    <td><span class="badge bg-danger">@q.FailRate%</span></td>
                                    <td>
                                        @if (q.IsHardest)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-fire me-1"></i>Câu khó nhất</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Bình thường</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (Model != null && Model.ScoreDistribution.Any())
            {
                var labelsJson = System.Text.Json.JsonSerializer.Serialize(Model.ScoreDistribution.Select(b => b.Score.ToString("0.0") + " điểm"));
                var dataJson = System.Text.Json.JsonSerializer.Serialize(Model.ScoreDistribution.Select(b => b.StudentCount));

                <text>
                const ctx = document.getElementById('scoreDistributionChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(labelsJson),
                        datasets: [{
                            label: 'Số lượng sinh viên',
                            data: @Html.Raw(dataJson),
                            backgroundColor: 'rgba(54, 162, 235, 0.7)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Số lượng sinh viên'
                                },
                                ticks: {
                                    stepSize: 1
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'Điểm trung bình các lượt thi'
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top'
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.raw + ' sinh viên đạt mức điểm này';
                                    }
                                }
                            }
                        }
                    }
                });
                </text>
            }
        });
    </script>
}
